#!/usr/bin/env bash
set -Eeuo pipefail

cd /workspaces/ai-apps/apps/quiz10

# Flutter y el servidor ADB deben funcionar dentro del contenedor.
unset ADB_SERVER_SOCKET
adb start-server >/dev/null

echo "Esperando al emulador Android..."

for ((i=0; i<150; i++)); do
    adb connect host.docker.internal:5556 >/dev/null 2>&1 || true

    if adb devices | grep -Eq '^host[.]docker[.]internal:5556[[:space:]]+device'; then
        echo "Emulador conectado. Iniciando Quiz10..."
        exec flutter run -d host.docker.internal:5556
    fi

    sleep 2
done

echo "No se pudo conectar con el emulador Android."
exit 1
