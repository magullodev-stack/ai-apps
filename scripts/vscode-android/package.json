{
  "name": "ai-apps-android",
  "displayName": "AI-APPS Android",
  "description": "Gestiona sesiones Android independientes y sus visores EmbeDroid.",
  "version": "0.2.0",
  "publisher": "magullodev",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "magullodev.ai-apps-embedroid"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "aiAppsAndroid.select",
        "title": "Seleccionar visores",
        "category": "AI-APPS Android",
        "icon": "$(device-mobile)"
      },
      {
        "command": "aiAppsAndroid.open",
        "title": "Visualizar sesión",
        "category": "AI-APPS Android",
        "icon": "$(open-preview)"
      },
      {
        "command": "aiAppsAndroid.reconnect",
        "title": "Reconectar visor",
        "category": "AI-APPS Android",
        "icon": "$(debug-restart)"
      },
      {
        "command": "aiAppsAndroid.start",
        "title": "Iniciar sesión",
        "category": "AI-APPS Android",
        "icon": "$(play)"
      },
      {
        "command": "aiAppsAndroid.stop",
        "title": "Detener aplicación",
        "category": "AI-APPS Android",
        "icon": "$(debug-stop)"
      },
      {
        "command": "aiAppsAndroid.register",
        "title": "Registrar aplicación Flutter",
        "category": "AI-APPS Android",
        "icon": "$(add)"
      },
      {
        "command": "aiAppsAndroid.refresh",
        "title": "Actualizar sesiones",
        "category": "AI-APPS Android",
        "icon": "$(refresh)"
      },
      {
        "command": "aiAppsAndroid.auth",
        "title": "Volver a Auth (F7)",
        "category": "AI-APPS Android"
      },
      {
        "command": "aiAppsAndroid.preview",
        "title": "Abrir experiencia en el emulador",
        "category": "AI-APPS Android"
      },
      {
        "command": "aiAppsAndroid.realFlow",
        "title": "Abrir recorrido real",
        "category": "AI-APPS Android",
        "icon": "$(play-circle)"
      },
      {
        "command": "aiAppsAndroid.findExperience",
        "title": "Buscar pantalla…",
        "category": "AI-APPS Android",
        "icon": "$(search)"
      },
      {
        "command": "aiAppsAndroid.hideVisualAsset",
        "title": "Ocultar imagen",
        "category": "AI-APPS Android",
        "icon": "$(eye)"
      },
      {
        "command": "aiAppsAndroid.showVisualAsset",
        "title": "Mostrar imagen",
        "category": "AI-APPS Android",
        "icon": "$(eye-closed)"
      },
      {
        "command": "aiAppsAndroid.replaceVisualAsset",
        "title": "Sustituir imagen…",
        "category": "AI-APPS Android",
        "icon": "$(replace)"
      },
      {
        "command": "aiAppsAndroid.deleteVisualAsset",
        "title": "Eliminar imagen…",
        "category": "AI-APPS Android",
        "icon": "$(trash)"
      },
      {
        "command": "aiAppsAndroid.pendingVisualAsset",
        "title": "⏳ Pendiente de colocar",
        "category": "AI-APPS Android",
        "icon": {
          "light": "media/hourglass-light.svg",
          "dark": "media/hourglass-dark.svg"
        }
      },
      {
        "command": "aiAppsAndroid.renameVisualAsset",
        "title": "Cambiar nombre de imagen…",
        "category": "AI-APPS Android",
        "icon": "$(edit)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "aiAppsAndroid.sessions",
          "name": "AI-APPS Android"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aiAppsAndroid.select",
          "when": "view == aiAppsAndroid.sessions",
          "group": "navigation"
        },
        {
          "command": "aiAppsAndroid.register",
          "when": "view == aiAppsAndroid.sessions",
          "group": "navigation"
        },
        {
          "command": "aiAppsAndroid.refresh",
          "when": "view == aiAppsAndroid.sessions",
          "group": "navigation"
        },
        {
          "command": "aiAppsAndroid.findExperience",
          "when": "view == aiAppsAndroid.sessions",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "aiAppsAndroid.open",
          "when": "view == aiAppsAndroid.sessions && (viewItem == androidExternal || viewItem == androidStopped || viewItem == androidRunning)",
          "group": "inline"
        },
        {
          "command": "aiAppsAndroid.reconnect",
          "when": "view == aiAppsAndroid.sessions",
          "group": "session"
        },
        {
          "command": "aiAppsAndroid.start",
          "when": "view == aiAppsAndroid.sessions && (viewItem == androidStopped)",
          "group": "session"
        },
        {
          "command": "aiAppsAndroid.stop",
          "when": "view == aiAppsAndroid.sessions && (viewItem == androidRunning)",
          "group": "session"
        },
        {
          "command": "aiAppsAndroid.hideVisualAsset",
          "when": "view == aiAppsAndroid.sessions && viewItem == visualAssetVisible",
          "group": "inline@1"
        },
        {
          "command": "aiAppsAndroid.showVisualAsset",
          "when": "view == aiAppsAndroid.sessions && viewItem == visualAssetHidden",
          "group": "inline@1"
        },
        {
          "command": "aiAppsAndroid.replaceVisualAsset",
          "when": "view == aiAppsAndroid.sessions && (viewItem == visualAssetVisible || viewItem == visualAssetHidden || viewItem == visualAssetPending)",
          "group": "navigation@1"
        },
        {
          "command": "aiAppsAndroid.deleteVisualAsset",
          "when": "view == aiAppsAndroid.sessions && (viewItem == visualAssetVisible || viewItem == visualAssetHidden || viewItem == visualAssetPending)",
          "group": "navigation@2"
        },
        {
          "command": "aiAppsAndroid.pendingVisualAsset",
          "when": "view == aiAppsAndroid.sessions && viewItem == visualAssetPending",
          "group": "inline@1"
        },
        {
          "command": "aiAppsAndroid.renameVisualAsset",
          "when": "view == aiAppsAndroid.sessions && (viewItem == visualAssetVisible || viewItem == visualAssetHidden || viewItem == visualAssetPending)",
          "group": "navigation@0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiAppsAndroid.auth",
        "key": "f7",
        "when": "config.aiAppsAndroid.devShortcuts"
      }
    ],
    "configuration": {
      "title": "AI-APPS Android",
      "properties": {
        "aiAppsAndroid.devShortcuts": {
          "type": "boolean",
          "default": false,
          "description": "Activa F7 para mostrar Auth de Muondia durante el desarrollo."
        }
      }
    }
  }
}
